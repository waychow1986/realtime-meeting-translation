{
  "schemaVersion": 2,
  "services": [
    {
      "name": "web",
      "description": "实时中文字幕 Web 应用（麦克风 / 系统声音两种输入、悬浮字幕小窗；字号与字幕行距可调并保存在本机浏览器；字幕只显示判定为中文的译文；系统声音模式识别静默停滞时转为出错并提示重新开始）：提供页面与脚本、语音授权令牌签发（/api/speech-token）与流式翻译代理（/api/translations，客户端中止按信息级记录）。",
      "build": {
        "context": ".",
        "file": "Dockerfile"
      },
      "port": 8080,
      "healthPath": "/healthz",
      "exposed": true
    }
  ],
  "operations": {
    "errorLogRules": [
      {
        "name": "app-error-or-fatal",
        "kind": "structured",
        "field": "level",
        "values": [
          "error",
          "fatal"
        ],
        "messageField": "msg",
        "severity": "high"
      },
      {
        "name": "upstream-errors-burst",
        "kind": "structured",
        "field": "event",
        "values": [
          "upstream_error"
        ],
        "messageField": "errorCode",
        "severity": "medium",
        "threshold": {
          "windowMinutes": 5,
          "count": 10
        }
      },
      {
        "name": "node-crash-output",
        "kind": "pattern",
        "pattern": "^(?<message>(?:Uncaught |node:internal)?[A-Za-z]*Error(?: \\[[A-Z_]+\\])?: .+)$",
        "severity": "high"
      }
    ]
  }
}
