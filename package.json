{
  "name": "realtime-meeting-translation",
  "version": "0.1.0",
  "private": true,
  "description": "会议中把外语发言实时翻译成中文字幕的 Web 应用",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
